# Copy to .env.local (gitignored) and fill in. `pnpm tauri:dev` sources it.
#
# Debug builds never touch the macOS keychain: every `tauri dev` rebuild gets
# a new ad-hoc code signature, so the keychain treats it as a different app
# and re-prompts for your device password however often you click "Always
# Allow". Secrets live in memory for the session instead (`mod dev` in
# secrets.rs). Release builds always use the keychain.
#
# Optional: set TINFOIL_API_KEY to seed that in-memory store, so Tinfoil
# models work in dev. Left empty, dev starts without a key, like a fresh
# install. Not read by the frontend: Vite only exposes VITE_-prefixed vars.
TINFOIL_API_KEY=

# Set to 1 to use the real keychain in a debug build, prompts and all.
# BLOBBIES_DEV_KEYCHAIN=1
