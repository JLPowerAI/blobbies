# Copy to .env.local (gitignored) and fill in. `pnpm tauri:dev` sources it.
#
# Debug builds never touch the macOS keychain: every `tauri dev` rebuild gets
# a new ad-hoc code signature, so the keychain treats it as a different app
# and re-prompts for your device password however often you click "Always
# Allow". Secrets live in memory for the session instead (`mod dev` in
# secrets.rs). Release builds always use the keychain.
#
# That map is seeded from the variables below, so dev starts with the same
# credentials a real install has. Leave one empty and dev starts without it,
# like a fresh install — but nothing needing it can be tested. None of these
# reach the frontend: Vite only exposes VITE_-prefixed vars.
#
# Values already in your keychain can be copied across without printing them:
#
#   security find-generic-password -s com.blobbies.app -a composio-oauth -w \
#     | sed 's/^/COMPOSIO_OAUTH=/' >> .env.local
#
# Tinfoil models. Without it, dev has no hosted model to answer with.
TINFOIL_API_KEY=

# Composio, which is what connects the app tools (Gmail, YouTube, …). Without
# one of these, the app_* tools report no connected account in dev. The OAuth
# session is what connecting in Settings produces and what the app prefers;
# the pasted API key is the fallback. JSON, on one line.
COMPOSIO_OAUTH=
COMPOSIO_API_KEY=

# Set to 1 to use the real keychain in a debug build, prompts and all.
# BLOBBIES_DEV_KEYCHAIN=1
