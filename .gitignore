# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*

# Dependencies & build output
node_modules
dist
dist-ssr
coverage
*.local

# Rust / Tauri
src-tauri/target
src-tauri/gen

# Secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.p12
*.keystore
*.jks
# Update signing keys. The real ones live in ~/.blobbies-keys, outside the
# repo, so these are a backstop for the day one gets copied in "just to
# check": a committed private key lets anyone sign an update that every
# installed copy of Blobbies accepts as genuine, and a public repo means it
# is scraped within minutes.
*.key
*.key.password
.blobbies-keys/

# Editor directories and files
.vscode/
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Generated mobile icons (no mobile targets configured)
src-tauri/icons/android
src-tauri/icons/ios

# Agent scratch
.gg/

# Local-only context and planning — the user's own notes, never for the repo
CLAUDE.md
docs/

# Model-tuning harness (runs via vitest.sim.config.ts, never gates CI).
#
# The source is tracked: these sims are how a prompt or tool-description change
# gets measured against a real model, and losing them on a clone means the next
# person tunes blind. Not running in CI is a workflow decision, not a reason to
# leave the harness out of the repo.
#
# Anything a *run* produces stays ignored, by default-deny: only `.ts` is
# tracked, so a report, a cache or a scratch directory added later needs no new
# rule here. Sim runs need TINFOIL_API_KEY or a local Ollama from the
# environment, so no file in here ever holds a credential.
sim/*
!sim/*.ts

# Stale tsc incremental state (the live one lives in node_modules/.tmp)
*.tsbuildinfo

# Plugin sync auth-probe cache (regenerated by scripts/sync-plugins.mjs)
scripts/.plugin-sync-cache.json
