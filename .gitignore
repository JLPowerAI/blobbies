# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*

# Dependencies & build output
node_modules
dist
dist-ssr
coverage
*.local

# Rust / Tauri
src-tauri/target
src-tauri/gen

# Secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.p12
*.keystore
*.jks
# Update signing keys. The real ones live in ~/.blobbies-keys, outside the
# repo, so these are a backstop for the day one gets copied in "just to
# check": a committed private key lets anyone sign an update that every
# installed copy of Blobbies accepts as genuine, and a public repo means it
# is scraped within minutes.
*.key
*.key.password
.blobbies-keys/

# Editor directories and files
.vscode/
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Generated mobile icons (no mobile targets configured)
src-tauri/icons/android
src-tauri/icons/ios

# Agent scratch
.gg/

# Local-only context and planning — the user's own notes, never for the repo
CLAUDE.md
docs/

# Local-only dev harness: model tuning that never gates CI (runs via vitest.sim.config.ts)
sim/
vitest.sim.config.ts

# Stale tsc incremental state (the live one lives in node_modules/.tmp)
*.tsbuildinfo

# Plugin sync auth-probe cache (regenerated by scripts/sync-plugins.mjs)
scripts/.plugin-sync-cache.json
